{
  "name": "@bigfish/dsh-client-ui-white-label",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "description": "N.E.K.O. 工作台 product brand for the DSH Web GUI: selectable chibi avatar, hero avatar gallery, wordmark, product strip with 工作台选项, document title and favicon",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib"
  ],
  "scripts": {
    "smoke": "node scripts/smoke.mjs",
    "dom-check": "node scripts/dom-check.mjs",
    "embed-avatars": "node scripts/embed-avatars.mjs"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-workspace-controller",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  }
}
