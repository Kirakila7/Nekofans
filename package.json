{
  "name": "nekofans",
  "version": "0.28.41",
  "private": true,
  "main": "apps/desktop/main.cjs",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "setup:neko-memory": "uv sync --project services/neko-memory --frozen",
    "setup:electron": "install-electron --no",
    "start": "node scripts/start-desktop.mjs",
    "start:neko": "node scripts/start-neko-workbench.mjs",
    "test": "node scripts/test-v1.mjs",
    "test:neko": "node scripts/test-neko-workbench.mjs",
    "check:neko": "npm --prefix apps/neko-workbench run check",
    "test:desktop": "node tests/desktop/run-smoke.mjs",
    "test:dsh": "node tests/desktop/dsh-host-smoke.mjs",
    "check:distribution": "node scripts/check-distribution.mjs",
    "build:portable": "node scripts/build-portable.mjs",
    "test:portable": "node tests/desktop/portable-smoke.mjs"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "pe-library": "2.0.1",
    "resedit": "3.1.0"
  },
  "productName": "Nekofans",
  "description": "Nekofans workbench: desktop companion, multi-agent creation desk and N.E.K.O. community",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Kirakila7/Nekofans.git"
  },
  "bugs": {
    "url": "https://github.com/Kirakila7/Nekofans/issues"
  },
  "homepage": "https://github.com/Kirakila7/Nekofans#readme"
}
